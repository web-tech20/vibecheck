# Clé API ElevenLabs — https://elevenlabs.io/
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Clé privée Solana (format tableau JSON, ex: [12,34,56,...])
# Générer avec : solana-keygen new --outfile keypair.json
SOLANA_PRIVATE_KEY=[votre_clé_privée_ici]

# Port du serveur (optionnel, défaut: 3000)
PORT=3000
